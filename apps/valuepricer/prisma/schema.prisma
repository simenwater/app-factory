generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?
  subscriptionTier     String    @default("free")
  subscriptionStatus   String?

  accounts       Account[]
  sessions       Session[]
  valueInputs    ValueInput[]
  recommendations PricingRecommendation[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ValueInput {
  id                         String   @id @default(cuid())
  createdAt                  DateTime @default(now())
  userId                     String
  productName                String
  industry                   String
  targetCustomerSize         String
  engineerCount              Int
  avgHourlyCost              Float
  hoursSavedPerWeek          Float
  additionalCostSavingsMonthly Float
  currentProcessDescription  String   @default("")
  competitorPrice            Float    @default(0)

  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendations PricingRecommendation[]
}

model PricingRecommendation {
  id                    String   @id @default(cuid())
  createdAt             DateTime @default(now())
  inputId               String
  userId                String
  productName           String
  industry              String
  totalValueDelivered   Float
  recommendedModel      String
  modelReasoning        String
  tiersJson             String
  roi                   Float
  competitorComparison  String
  keyInsightsJson       String

  input ValueInput @relation(fields: [inputId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}
